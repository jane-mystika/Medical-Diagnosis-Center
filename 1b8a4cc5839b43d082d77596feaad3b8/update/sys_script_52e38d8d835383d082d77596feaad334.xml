        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

	if (current.report_number.nil() || current.report_number == '') { 
		var count = new GlideAggregate('mdc_report');
		count.addAggregate('COUNT');
		count.query();
		var total = 1;
		if (count.next()) {
			total = parseInt(count.getAggregate('COUNT')) + 1;
			} 
		var padded = ('0000000' + total).slice(-7); current.report_number = 'RPT' + padded;
	} 

})(current, previous);]]></script>
