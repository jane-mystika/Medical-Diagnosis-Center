        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

    // Only react when approval_status actually changed
    if (current.approval_status == previous.approval_status) {
        return;
    }

    if (current.approval_status == "Rejected") {
        current.rejection_reason = "Cancelled/Rejected by the user";
        current.approved_by = "";
        current.approval_date = new GlideDateTime();
    }

    if (current.approval_status == "Approved") {
        current.approved_by = gs.getUserID();
        current.rejection_reason = "";
        current.approval_date = new GlideDateTime();
    }

})(current, previous);]]></script>
